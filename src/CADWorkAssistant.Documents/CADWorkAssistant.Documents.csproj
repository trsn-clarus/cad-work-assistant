<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0만 타겟한다 - Persistence(net8.0, docs/PERSISTENCE.md)와 같은 이유다. AutoCAD Plugin(net48)은
      이 프로젝트를 절대 참조하지 않는다(Milestone 9 §6, §159-162) - Documents는 Desktop 전용이다.
      원래 netstandard2.0이었으나 실제로 참조하는 프로젝트가 아직 없었고(빈 프로젝트), ClosedXML을
      추가하면서 Persistence와 같은 근거로 net8.0으로 확정했다.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ClosedXML - .xlsx를 OpenXML 형식으로 직접 생성한다. Microsoft Excel/Interop/COM Automation을
      쓰지 않는다(Milestone 9 §4) - Excel 설치 여부와 무관하게 동작해야 하고, 서버/헤드리스 테스트에서
      COM lifetime 문제를 피해야 한다. MIT 라이선스, 상업적 사용 제약 없음, 활발히 유지보수됨
      (2억+ 다운로드). `docs/EXCEL_EXPORT.md` §Library Choice에 선택 근거를 기록한다.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />

    <!--
      PDFsharp-MigraDoc - .pdf를 직접 생성한다(Milestone 10 §46-47, Print-to-PDF/OS printer/외부
      프로세스 없음). QuestPDF도 검토했으나 $1M 미만 매출 조직에만 무료인 Community License 조건이
      있어(nuget.org/packages/QuestPDF 확인) 배포 대상 회사 규모를 알 수 없는 이 제품에는 위험하다고
      판단했다. PDFsharp-MigraDoc(공식 PDFsharp-Team 패키지)은 매출 조건 없는 순수 MIT이고, net8.0을
      정식 지원하며(6.2.4), MigraDoc의 Word-processor 스타일 문서 모델(Section/Paragraph/Table +
      자동 페이지 나눔)이 §61-65가 요구하는 자연스러운 페이지 확장에 잘 맞는다. `docs/PDF_EXPORT.md`
      §Library Choice에 선택 근거를 기록한다.
    -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CADWorkAssistant.Core\CADWorkAssistant.Core.csproj" />
  </ItemGroup>

</Project>
