<UserControl x:Class="CADWorkAssistant.Desktop.Views.ParapetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ParapetWorkflowViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:DrawingUnitAbbreviationConverter x:Key="UnitAbbreviation" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="파라펫" FontSize="22" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="480" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding Source.RunSelectionCommand}"
                AutomationProperties.Name="CAD에서 파라펫 둘레 선택"
                Content="CAD에서 둘레 선택"
                Visibility="{Binding Source.IsCadSelectionSource, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="기준 길이 (둘레)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

          <RadioButton GroupName="ParapetSource"
                       Content="CAD에서 새로 선택"
                       IsChecked="{Binding Source.IsCadSelectionSource}"
                       AutomationProperties.Name="CAD에서 새로 선택" />
          <TextBlock Margin="20,4,0,10"
                     Style="{StaticResource NumericText}"
                     Text="{Binding Source.LengthDisplay}"
                     Visibility="{Binding Source.IsCadSelectionSource, Converter={StaticResource BoolToVisibility}}" />

          <RadioButton GroupName="ParapetSource"
                       Content="최근 측정값 사용"
                       IsChecked="{Binding Source.IsExistingMeasurementSource}"
                       IsEnabled="{Binding Source.HasExistingMeasurement}"
                       AutomationProperties.Name="최근 측정값 사용"
                       Margin="0,8,0,0" />
          <TextBlock Margin="20,4,0,10"
                     Style="{StaticResource CaptionText}"
                     Text="{Binding Source.ExistingMeasurementSummary}" />

          <RadioButton GroupName="ParapetSource"
                       Content="직접 입력"
                       IsChecked="{Binding Source.IsManualSource}"
                       AutomationProperties.Name="길이 직접 입력"
                       Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal"
                      Margin="20,6,0,0"
                      Visibility="{Binding Source.IsManualSource, Converter={StaticResource BoolToVisibility}}">
            <TextBox Width="120"
                     AutomationProperties.Name="길이 값"
                     Text="{Binding Source.ManualLengthText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="72"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="길이 단위"
                      ItemsSource="{Binding Source.ManualLengthUnitOptions}"
                      SelectedItem="{Binding Source.ManualLengthUnit}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource UnitAbbreviation}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="높이" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBox Width="120"
                     AutomationProperties.Name="높이 값"
                     Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="72"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="높이 단위"
                      ItemsSource="{Binding HeightUnitOptions}"
                      SelectedItem="{Binding HeightUnit}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource UnitAbbreviation}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <TextBlock Text="면" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton GroupName="ParapetFace"
                         Content="한 면"
                         IsChecked="{Binding IsSingleFace}"
                         AutomationProperties.Name="한 면"
                         Margin="0,0,16,0" />
            <RadioButton GroupName="ParapetFace"
                         Content="양면"
                         IsChecked="{Binding IsBothFaces}"
                         AutomationProperties.Name="양면" />
          </StackPanel>
          <Border Style="{StaticResource InlineMessageBorder}"
                  Margin="0,4,0,14"
                  Visibility="{Binding IsBothFaces, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="양면 계산은 동일한 기준 길이를 두 면에 적용합니다." Style="{StaticResource InlineMessageText}" />
          </Border>

          <CheckBox Content="상부면 포함"
                     IsChecked="{Binding TopIncluded}"
                     AutomationProperties.Name="상부면 포함" />
          <StackPanel Orientation="Horizontal"
                      Margin="20,8,0,0"
                      Visibility="{Binding TopIncluded, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="상부 폭" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="100"
                     AutomationProperties.Name="상부 폭 값"
                     Text="{Binding TopWidthText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="72"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="상부 폭 단위"
                      ItemsSource="{Binding TopWidthUnitOptions}"
                      SelectedItem="{Binding TopWidthUnit}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource UnitAbbreviation}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="14">
        <StackPanel>
          <TextBlock Text="측면" Style="{StaticResource CaptionText}" />
          <Grid Margin="0,2,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SideFormulaDisplay}" Style="{StaticResource NumericText}" />
            <TextBlock Grid.Column="1" Text="{Binding SideAreaDisplay}" Style="{StaticResource NumericText}" />
          </Grid>

          <StackPanel Visibility="{Binding TopIncluded, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="상부" Style="{StaticResource CaptionText}" />
            <Grid Margin="0,2,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding TopFormulaDisplay}" Style="{StaticResource NumericText}" />
              <TextBlock Grid.Column="1" Text="{Binding TopAreaDisplay}" Style="{StaticResource NumericText}" />
            </Grid>
          </StackPanel>

          <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,4,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="총 면적" Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding TotalValueDisplay}" Style="{StaticResource NumericText}" FontSize="24" />
                <TextBlock Text="m²"
                           Style="{StaticResource NumericUnitText}"
                           FontSize="14"
                           Margin="5,0,0,2"
                           VerticalAlignment="Bottom"
                           Visibility="{Binding TotalValueDisplay, Converter={StaticResource StringToVisibility}}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Style="{StaticResource QuietButton}"
                      Command="{Binding CopyResultCommand}"
                      AutomationProperties.Name="결과 값 복사"
                      Margin="0,0,6,0"
                      Content="값 복사" />
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding AddToQuantitySheetCommand}"
                      AutomationProperties.Name="산출내역에 추가"
                      Content="산출내역 추가" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
