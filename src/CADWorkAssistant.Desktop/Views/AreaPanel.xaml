<UserControl x:Class="CADWorkAssistant.Desktop.Views.AreaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AreaWorkflowViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="면적 산출" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="480" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1"
              Style="{StaticResource PrimaryButton}"
              Command="{Binding RunSelectionCommand}"
              AutomationProperties.Name="CAD에서 면적 계산할 영역 선택"
              Content="CAD에서 영역 선택" />
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource InlineMessageBorder}"
            Margin="0,0,0,12"
            Visibility="{Binding HasExcludedSummary, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ExcludedSummary}" Style="{StaticResource InlineMessageText}" />
    </Border>

    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="선택 영역" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="HANDLE" Binding="{Binding Handle}" Width="90" />
            <DataGridTextColumn Header="TYPE" Binding="{Binding GeometryType}" Width="100" />
            <DataGridTextColumn Header="LAYER" Binding="{Binding Layer}" Width="140" />
            <DataGridTextColumn Header="AREA" Binding="{Binding AreaDisplay}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="총 면적" Style="{StaticResource CaptionText}" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding TotalValueDisplay}" Style="{StaticResource NumericText}" FontSize="26" />
            <TextBlock Text="m²"
                       Style="{StaticResource NumericUnitText}"
                       FontSize="15"
                       Margin="5,0,0,3"
                       VerticalAlignment="Bottom"
                       Visibility="{Binding TotalValueDisplay, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Style="{StaticResource QuietButton}"
                  Command="{Binding CopyResultCommand}"
                  AutomationProperties.Name="결과 값 복사"
                  Margin="0,0,6,0"
                  Content="값 복사" />
          <Button Style="{StaticResource SecondaryButton}"
                  Command="{Binding AddToQuantitySheetCommand}"
                  AutomationProperties.Name="산출내역에 추가"
                  Content="산출내역 추가" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
