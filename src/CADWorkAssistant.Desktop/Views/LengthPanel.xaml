<UserControl x:Class="CADWorkAssistant.Desktop.Views.LengthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LengthWorkflowViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="길이 산출" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="480" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1"
              Style="{StaticResource PrimaryButton}"
              Command="{Binding RunSelectionCommand}"
              AutomationProperties.Name="CAD에서 길이 계산할 객체 선택"
              Content="CAD에서 객체 선택" />
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource PanelBorder}"
            Padding="12"
            Margin="0,0,0,12"
            Visibility="{Binding HasExcludedSummary, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ExcludedSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="선택 객체" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="HANDLE" Binding="{Binding Handle}" Width="90" />
            <DataGridTextColumn Header="TYPE" Binding="{Binding GeometryType}" Width="100" />
            <DataGridTextColumn Header="LAYER" Binding="{Binding Layer}" Width="140" />
            <DataGridTextColumn Header="LENGTH" Binding="{Binding LengthDisplay}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="총 길이" Style="{StaticResource CaptionText}" />
          <TextBlock Text="{Binding TotalDisplay}"
                     Style="{StaticResource NumericText}"
                     FontSize="24"
                     Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Command="{Binding CopyResultCommand}"
                  AutomationProperties.Name="결과 값 복사"
                  Margin="0,0,6,0"
                  Content="값 복사" />
          <Button Style="{StaticResource PrimaryButton}"
                  Command="{Binding AddToQuantitySheetCommand}"
                  AutomationProperties.Name="산출내역에 추가"
                  Content="산출내역 추가" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
