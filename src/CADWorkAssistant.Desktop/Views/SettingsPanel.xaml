<UserControl x:Class="CADWorkAssistant.Desktop.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <UserControl.Resources>
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Program information, data location, and support links" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="20" VerticalAlignment="Top" MaxWidth="520" HorizontalAlignment="Left">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/AppIcon.png" Width="44" Height="44" Margin="0,0,14,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AppName}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ReleaseChannelText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <Border BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />

        <TextBlock Text="DATA" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding DataFolderPath}" Style="{StaticResource InspectorValue}" TextWrapping="Wrap" ToolTip="{Binding DataFolderPath}" />
        <TextBlock Text="Projects, quantities, verification records, settings, and logs are stored outside the install folder. Uninstall keeps this data."
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,10" />
        <Button Style="{StaticResource SecondaryButton}"
                Command="{Binding OpenDataFolderCommand}"
                AutomationProperties.Name="Open data folder"
                Content="Open data folder"
                HorizontalAlignment="Left" />
        <Button Style="{StaticResource SecondaryButton}"
                Command="{Binding OpenLogFolderCommand}"
                AutomationProperties.Name="Open log folder"
                Content="Open log folder"
                Margin="0,8,0,0"
                HorizontalAlignment="Left" />

        <Border BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />

        <TextBlock Text="HELP" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
        <TextBlock Text="Open the installed user manual PDF with the default PDF application."
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <Button Style="{StaticResource SecondaryButton}"
                Command="{Binding OpenUserManualCommand}"
                AutomationProperties.Name="Open user manual"
                Content="Open user manual"
                HorizontalAlignment="Left" />
        <Border Style="{StaticResource InlineMessageBorder}"
                Margin="0,10,0,0"
                Visibility="{Binding ManualErrorMessage, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
          <TextBlock Text="{Binding ManualErrorMessage}" Style="{StaticResource InlineMessageText}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Border BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />

        <TextBlock Text="{Binding CompanyText}" Style="{StaticResource CaptionText}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
