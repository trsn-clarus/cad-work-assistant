<UserControl x:Class="CADWorkAssistant.Desktop.Views.DrawingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DrawingWorkflowViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: 제목 + 상태, 선택 방식, 핵심 행동(Primary) -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="도면 탐색" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
        <RadioButton GroupName="DrawingSelectionMode"
                     Content="Window"
                     IsChecked="{Binding IsWindowMode}"
                     ToolTip="영역 내부에 완전히 들어온 객체만 선택합니다"
                     AutomationProperties.Name="Window 선택"
                     Margin="0,0,12,0" />
        <RadioButton GroupName="DrawingSelectionMode"
                     Content="Crossing"
                     IsChecked="{Binding IsCrossingMode}"
                     ToolTip="영역에 닿는 객체까지 포함합니다"
                     AutomationProperties.Name="Crossing 선택" />
      </StackPanel>
      <Button Grid.Column="2"
              Style="{StaticResource PrimaryButton}"
              Command="{Binding RunSelectionCommand}"
              AutomationProperties.Name="CAD에서 영역 선택"
              Content="영역 선택" />
    </Grid>

    <!-- Secondary Toolbar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Style="{StaticResource SecondaryButton}"
              Command="{Binding ZoomExtentsCommand}"
              AutomationProperties.Name="전체 도면 보기"
              Content="전체 보기"
              Margin="0,0,6,0" />
      <Button Style="{StaticResource SecondaryButton}"
              Command="{Binding ZoomToSelectionCommand}"
              AutomationProperties.Name="선택 영역 보기"
              Content="선택 영역 보기"
              Margin="0,0,6,0" />
      <Button Style="{StaticResource SecondaryButton}"
              Command="{Binding IsolateSelectionCommand}"
              AutomationProperties.Name="선택 객체만 보기"
              Content="선택 객체만 보기"
              Margin="0,0,6,0" />
      <Button Style="{StaticResource SecondaryButton}"
              Command="{Binding IsolateSelectedLayersCommand}"
              AutomationProperties.Name="선택 Layer만 보기"
              Content="선택 Layer만 보기"
              Margin="0,0,6,0" />
      <Button Style="{StaticResource QuietButton}"
              Command="{Binding RestoreCommand}"
              AutomationProperties.Name="전체 복원"
              Content="전체 복원" />
    </StackPanel>

    <!-- Isolation 상태 배너 - 실수로 잊지 않게 한다 (§94-96) -->
    <Border Grid.Row="2"
            Style="{StaticResource InlineMessageBorder}"
            Margin="0,0,0,10"
            Visibility="{Binding IsIsolationActive, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{StaticResource InlineMessageText}" FontWeight="SemiBold"
                 Text="격리된 화면을 표시 중입니다 - 위의 &quot;전체 복원&quot;으로 원래 상태로 되돌릴 수 있습니다." />
    </Border>

    <!-- 본문: 선택 결과 | Layer Manager -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="320" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="선택 객체" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding SelectionSummaryText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding TypeSummaryText}"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Visibility="{Binding TypeSummaryText, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="HANDLE" Binding="{Binding Handle}" Width="90" />
              <DataGridTextColumn Header="TYPE" Binding="{Binding ObjectType}" Width="140" />
              <DataGridTextColumn Header="LAYER" Binding="{Binding Layer}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BrushDivider}" />

      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Layer Manager" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <TextBox Grid.Row="1"
                    Text="{Binding Layers.SearchText, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Layer 검색"
                    ToolTip="Layer 이름으로 검색"
                    Margin="0,0,0,8" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Layers.FilteredLayers}" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="표시" Binding="{Binding IsOn, Mode=TwoWay}" Width="44" />
              <DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
              <!-- IsFrozen/IsLocked는 getter만 있는 읽기 전용 속성이다 - DataGridCheckBoxColumn은
                   IsReadOnly="True"(셀 편집 금지)여도 바인딩 자체는 기본이 TwoWay라 Mode=OneWay를
                   명시하지 않으면 "읽기 전용 속성에서 TwoWay 바인딩 불가" 예외가 던져진다. 이 예외가
                   처리되지 않은 채 레이아웃 패스 도중 발생해 Layer Manager 전체가 빈 채로 남아있던
                   실제 렌더링 버그였다(Simulation Mode 로그로 확인). -->
              <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding IsFrozen, Mode=OneWay}" Width="52" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="Lock" Binding="{Binding IsLocked, Mode=OneWay}" Width="48" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- Export -->
    <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="설명" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Width="220"
                    Text="{Binding Export.Description, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Export 설명"
                    ToolTip="예: 실내마감표" />
          <TextBlock Text="{Binding Export.SuggestedFileName}"
                     Style="{StaticResource NumericText}"
                     FontSize="12"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="{Binding Export.StatusText}"
                     Style="{StaticResource CaptionText}"
                     TextWrapping="Wrap"
                     MaxWidth="420"
                     Visibility="{Binding Export.StatusText, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource QuietButton}"
                  Command="{Binding Export.OpenFolderCommand}"
                  AutomationProperties.Name="폴더 열기"
                  Content="폴더 열기"
                  Margin="0,0,6,0" />
          <Button Style="{StaticResource SecondaryButton}"
                  Command="{Binding Export.ExportCommand}"
                  AutomationProperties.Name="선택 객체를 DWG로 저장"
                  Content="DWG로 저장" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
