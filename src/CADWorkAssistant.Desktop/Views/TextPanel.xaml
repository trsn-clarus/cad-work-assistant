<UserControl x:Class="CADWorkAssistant.Desktop.Views.TextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TextWorkflowViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Text" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Disconnected -->
    <StackPanel Grid.Row="1"
                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="360">
      <TextBlock Text="AutoCAD에 연결되어 있지 않습니다." HorizontalAlignment="Center" FontWeight="SemiBold" />
      <TextBlock Text="문자 도구는 실제 AutoCAD 문자 객체를 다루므로 연결이 필요합니다."
                 Style="{StaticResource CaptionText}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- §62: 편집/작성 segmented control -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
        <RadioButton GroupName="TextMode"
                     Content="편집"
                     IsChecked="{Binding IsEditMode}"
                     AutomationProperties.Name="문자 편집 모드"
                     Margin="0,0,16,0" />
        <RadioButton GroupName="TextMode"
                     Content="작성"
                     IsChecked="{Binding IsCreateMode}"
                     AutomationProperties.Name="새 문자 작성 모드" />
      </StackPanel>

      <!-- === 편집 모드 === -->
      <Grid Grid.Row="1" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="380" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="320" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Button Grid.Row="0"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding SelectCommand}"
                  AutomationProperties.Name="CAD에서 문자 선택"
                  Content="{Binding SelectButtonLabel}"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,10" />

          <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12">
            <Grid>
              <DataGrid ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding SelectedRow}"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="선택된 문자 목록"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="TYPE" Binding="{Binding TypeLabel}" Width="90" />
                  <DataGridTextColumn Header="CONTENT" Binding="{Binding ContentPreview}" Width="*" MinWidth="100" />
                  <DataGridTextColumn Header="LAYER" Binding="{Binding LayerName}" Width="90" />
                  <DataGridTextColumn Header="HEIGHT" Binding="{Binding Height, StringFormat=N0}" Width="70" />
                  <DataGridTextColumn Header="COLOR" Binding="{Binding ColorDisplay}" Width="100" />
                </DataGrid.Columns>
              </DataGrid>

              <TextBlock Text="아직 선택된 문자가 없습니다.&#10;위 버튼으로 AutoCAD에서 DBText/MText 객체를 선택하세요."
                         Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BrushDivider}" />

        <!-- 배치 편집 컨트롤 (§66-68) -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource PanelBorder}" Padding="12">
            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding SelectionSummaryText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10" />

              <TextBlock Text="내용" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
              <TextBox Text="{Binding ContentText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="문자 내용"
                        IsEnabled="{Binding IsSingleSelection}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="52"
                        Margin="0,0,0,4" />
              <TextBlock Text="{Binding ContentText}"
                         Style="{StaticResource CaptionText}"
                         Visibility="{Binding IsSingleSelection, Converter={StaticResource InverseBoolToVisibility}}" />
              <TextBlock Text="여러 문자를 선택하면 내용은 수정할 수 없습니다."
                         Style="{StaticResource CaptionText}"
                         TextWrapping="Wrap"
                         Visibility="{Binding IsSingleSelection, Converter={StaticResource InverseBoolToVisibility}}" />

              <Border BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0" Margin="0,14,0,14" />

              <CheckBox IsChecked="{Binding IncludeHeightChange}"
                        Content="높이 변경"
                        AutomationProperties.Name="높이 변경 포함"
                        Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="높이 값"
                          IsEnabled="{Binding IncludeHeightChange}"
                          Width="80"
                          Margin="0,0,6,0" />
                <TextBlock Text="현재:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding HeightSummaryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              </StackPanel>

              <CheckBox IsChecked="{Binding IncludeColorChange}"
                        Content="색상 변경"
                        AutomationProperties.Name="색상 변경 포함"
                        Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                <ComboBox ItemsSource="{Binding ColorChoices}"
                          SelectedItem="{Binding SelectedColor}"
                          AutomationProperties.Name="새 색상"
                          IsEnabled="{Binding IncludeColorChange}"
                          Width="140"
                          Margin="0,0,6,0">
                  <!-- DisplayMemberPath만으로는 이 앱의 커스텀 ComboBox ControlTemplate에서 닫힌
                       상태 선택 표시(SelectionBoxItemTemplate)가 자동 생성되지 않는다는 실제 버그를
                       Simulation Mode 렌더링에서 발견했다 - 타입 전체 이름(ToString() 기본값)이
                       그대로 보였다. ItemTemplate을 명시하면 확실히 적용된다. -->
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="현재:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ColorSummaryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              </StackPanel>

              <CheckBox IsChecked="{Binding IncludeLayerChange}"
                        Content="Layer 변경"
                        AutomationProperties.Name="Layer 변경 포함"
                        Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                <ComboBox ItemsSource="{Binding LayerNames}"
                          SelectedItem="{Binding SelectedLayerName}"
                          AutomationProperties.Name="새 Layer"
                          IsEnabled="{Binding IncludeLayerChange}"
                          Width="140"
                          Margin="0,0,6,0" />
                <TextBlock Text="현재:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding LayerSummaryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              </StackPanel>

              <Border Style="{StaticResource InlineMessageBorder}"
                      Margin="0,4,0,10"
                      Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource InlineMessageText}" TextWrapping="Wrap" />
              </Border>

              <Border Style="{StaticResource InlineMessageBorder}"
                      Margin="0,4,0,10"
                      Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource InlineMessageText}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
              </Border>

              <Button Style="{StaticResource PrimaryButton}"
                      Command="{Binding ApplyCommand}"
                      AutomationProperties.Name="문자 변경 적용"
                      Content="{Binding ApplyButtonLabel}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>

      <!-- === 작성 모드 (§35-37, §73-75) ===
           주의: Visibility와 DataContext를 같은 요소에 함께 두면 안 된다 - DataContext를 재정의하는
           순간 그 요소에 걸린 다른 바인딩(Visibility 포함)도 전부 새 DataContext(Create, 여기엔
           IsCreateMode가 없다) 기준으로 다시 풀리면서 조용히 실패해 기본값(Visible)으로 항상
           보이는 실제 버그를 겪었다(Simulation Mode 렌더링에서 직접 발견) - Visibility는 바깥
           Grid에, DataContext 재정의는 그 안의 StackPanel에 나눠서 건다. -->
      <Grid Grid.Row="1" Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibility}}">
      <StackPanel DataContext="{Binding Create}"
                  MaxWidth="480"
                  HorizontalAlignment="Left">
        <Border Style="{StaticResource PanelBorder}" Padding="16">
          <StackPanel>
            <TextBlock Text="형식" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton GroupName="TextCreateEntityType"
                           Content="단일행 문자"
                           IsChecked="{Binding IsSingleLine}"
                           AutomationProperties.Name="단일행 문자 작성"
                           Margin="0,0,16,0" />
              <RadioButton GroupName="TextCreateEntityType"
                           Content="여러행 문자"
                           IsChecked="{Binding IsMultiLine}"
                           AutomationProperties.Name="여러행 문자 작성" />
            </StackPanel>

            <TextBlock Text="내용" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="새 문자 내용"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Height="60"
                      Margin="0,0,0,10" />

            <TextBlock Text="높이" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="새 문자 높이"
                      Width="100"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10" />

            <TextBlock Text="Layer" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding LayerNames}"
                      SelectedItem="{Binding SelectedLayerName}"
                      AutomationProperties.Name="새 문자 Layer"
                      Width="200"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10" />

            <TextBlock Text="색상" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding ColorChoices}"
                      SelectedItem="{Binding SelectedColor}"
                      AutomationProperties.Name="새 문자 색상"
                      Width="200"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource InlineMessageBorder}"
                Margin="0,12,0,0"
                Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource InlineMessageText}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource InlineMessageBorder}"
                Margin="0,12,0,0"
                Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource InlineMessageText}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Button Style="{StaticResource PrimaryButton}"
                Command="{Binding CreateCommand}"
                AutomationProperties.Name="CAD에서 위치 지정 후 문자 작성"
                Content="{Binding ActionButtonLabel}"
                HorizontalAlignment="Left"
                Margin="0,16,0,0" />
      </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
