<UserControl x:Class="CADWorkAssistant.Desktop.Views.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QuantityHistoryViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
    <conv:VerificationSeverityToGlyphConverter x:Key="SeverityToGlyph" />
    <conv:VerificationSeverityToBrushConverter x:Key="SeverityToBrush" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: 제목 + 요약, 검산 실행 -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Quantity History" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" />
          <TextBlock Text="{Binding BatchProgressText}"
                     Style="{StaticResource CaptionText}"
                     Margin="10,0,0,0"
                     Visibility="{Binding BatchProgressText, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
          <TextBlock Text="{Binding StatusMessage}"
                     Style="{StaticResource CaptionText}"
                     Margin="10,0,0,0"
                     Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource QuietButton}"
                Command="{Binding CancelVerificationCommand}"
                AutomationProperties.Name="검산 취소"
                Content="취소"
                Margin="0,0,6,0"
                Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVisibility}}" />
        <Button Style="{StaticResource SecondaryButton}"
                Command="{Binding VerifySelectedCommand}"
                AutomationProperties.Name="선택 항목 검산"
                Content="선택 항목 검산"
                Margin="0,0,6,0" />
        <Button Style="{StaticResource PrimaryButton}"
                Command="{Binding VerifyAllCommand}"
                AutomationProperties.Name="전체 검산"
                Content="전체 검산" />
      </StackPanel>
    </Grid>

    <!-- Filter toolbar -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="180" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="산출내역 검색"
                ToolTip="설명 또는 원본 도면으로 검색"
                Margin="0,0,8,0" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding TypeFilterOptions}"
                SelectedItem="{Binding TypeFilter}"
                AutomationProperties.Name="유형 필터"
                Width="120"
                Margin="0,0,8,0" />
      <ComboBox Grid.Column="2"
                ItemsSource="{Binding VerificationFilterOptions}"
                SelectedItem="{Binding VerificationFilter}"
                AutomationProperties.Name="검산 상태 필터"
                Width="120"
                Margin="0,0,8,0" />
      <ComboBox Grid.Column="3"
                ItemsSource="{Binding ReviewFilterOptions}"
                SelectedItem="{Binding ReviewFilter}"
                AutomationProperties.Name="검토 상태 필터"
                Width="120" />
    </Grid>

    <!-- 본문: 산출내역 테이블 | Inspector -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="340" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="12">
        <DataGrid ItemsSource="{Binding FilteredRows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  AutomationProperties.Name="산출내역 목록">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="30">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- DataGridCheckBoxColumn 대신 직접 CheckBox를 쓴다 - DataGridCheckBoxColumn은
                       DataGrid의 셀 편집(Begin/CommitEdit) 생명주기를 타야 TwoWay 바인딩이 커밋되는데,
                       이 화면의 SelectionUnit=FullRow 조합에서 클릭해도 소스에 값이 반영되지 않는
                       실제 버그를 겪었다(Simulation Mode 클릭 자동화로 재현, 로그에 바인딩 setter
                       호출 자체가 찍히지 않는 것으로 확인). 셀 템플릿 안의 평범한 CheckBox는 DataGrid의
                       편집 생명주기를 타지 않고 자기 Click에서 즉시 커밋해 이 문제가 없다. -->
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="배치 작업에 포함" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="82" />
            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="80" />
            <!-- 나머지 6개 컬럼이 고정폭 합계 약 480px - 좁은 목록 pane(≈650-700px)에서도 DESCRIPTION이
                 압축될지언정 UNIT/VERIFICATION 같은 뒤쪽 고정폭 컬럼이 안 보이게 밀려나지 않는다
                 (Milestone 8 UI Audit에서 실제 스크린샷으로 확인 - 이전엔 DESCRIPTION=150(고정)이라
                 합계가 pane보다 넓어 UNIT 헤더가 "UI" 두 글자만 보이도록 잘렸었다). -->
            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="80" />
            <DataGridTextColumn Header="QTY" Binding="{Binding Value, StringFormat=N3}" Width="76" />
            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44" />
            <DataGridTemplateColumn Header="VERIFICATION" Width="126" SortMemberPath="VerificationLabel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VerificationGlyph}" FontWeight="Bold" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding VerificationLabel}" />
                    <TextBlock Text=" (재검산 필요)" Style="{StaticResource CaptionText}"
                               Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="REVIEW" Binding="{Binding ReviewLabel}" Width="64" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BrushDivider}" />

      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="RESULT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding SelectedRow.Type}" Style="{StaticResource InspectorValue}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Text="{Binding SelectedRow.Value, StringFormat=N3, Mode=OneWay}" Style="{StaticResource NumericText}" />
              <TextBlock Text=" " />
              <TextBlock Text="{Binding SelectedRow.Unit, Mode=OneWay}" Style="{StaticResource NumericUnitText}" />
            </StackPanel>

            <TextBlock Text="SOURCE" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
            <TextBlock Text="{Binding SelectedRow.SourceDrawing}" Style="{StaticResource InspectorValue}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedRow.Layer}" Style="{StaticResource InspectorLabel}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding SelectedRow.Record.CalculationExpression}"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding SelectedRow.Record.CalculationExpression, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />

            <TextBlock Text="VERIFICATION" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
            <ItemsControl ItemsSource="{Binding SelectedRow.Verification.Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToGlyph}}"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                               FontWeight="Bold" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="아직 검산하지 않았습니다."
                       Style="{StaticResource CaptionText}"
                       Margin="0,2,0,0"
                       Visibility="{Binding SelectedRow.HasVerification, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}" />

            <TextBlock Text="REVIEW" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
            <TextBlock Text="{Binding SelectedRow.ReviewLabel}" Style="{StaticResource InspectorValue}" Margin="0,0,0,6" />
            <TextBox Text="{Binding ReviewNoteDraft, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="검토 메모"
                      ToolTip="예: ㄱ자 평면이라 둘레가 길지만 정상"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Height="52" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding SaveReviewNoteCommand}"
                      AutomationProperties.Name="메모 저장"
                      Content="메모 저장"
                      Margin="0,0,6,0" />
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding MarkNeedsReviewCommand}"
                      AutomationProperties.Name="확인 필요로 표시"
                      Content="확인 필요"
                      Margin="0,0,6,0" />
              <Button Style="{StaticResource PrimaryButton}"
                      Command="{Binding MarkVerifiedCommand}"
                      AutomationProperties.Name="검토 완료로 표시"
                      Content="검토 완료" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <TextBlock Text="왼쪽 목록에서 산출내역을 선택하세요."
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Compare -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Style="{StaticResource InlineMessageBorder}"
              Visibility="{Binding HasCompareResult, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding CompareResultText}" Style="{StaticResource InlineMessageText}" TextWrapping="Wrap" />
      </Border>
      <Button Grid.Column="1"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding CompareCommand}"
              AutomationProperties.Name="선택한 두 산출내역 비교"
              Content="비교"
              VerticalAlignment="Top"
              Margin="10,0,0,0" />
    </Grid>
  </Grid>
</UserControl>
