<UserControl x:Class="CADWorkAssistant.Desktop.Views.DrawingPdfExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CADWorkAssistant.Desktop.ViewModels"
             xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DrawingPdfExportViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="도면 PDF 출력" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="AutoCAD Plot 엔진으로 현재 Layout 또는 지정한 영역을 PDF로 출력합니다." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Disconnected -->
    <StackPanel Grid.Row="1"
                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="360">
      <TextBlock Text="AutoCAD에 연결되어 있지 않습니다." HorizontalAlignment="Center" FontWeight="SemiBold" />
      <TextBlock Text="도면 PDF 출력은 실제 AutoCAD Plot 엔진을 사용하므로 연결이 필요합니다."
                 Style="{StaticResource CaptionText}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">

      <!-- Loading -->
      <StackPanel Visibility="{Binding IsLoadingCapabilities, Converter={StaticResource BoolToVisibility}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,40,0,0">
        <TextBlock Text="Plot 기능 정보를 불러오는 중..." HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Capability load failed -->
      <StackPanel Visibility="{Binding ShowLoadErrorMessage, Converter={StaticResource BoolToVisibility}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="360"
                  Margin="0,40,0,0">
        <TextBlock Text="{Binding LoadErrorText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
      </StackPanel>

      <!-- No PDF-capable device -->
      <StackPanel Visibility="{Binding ShowNoPdfDeviceMessage, Converter={StaticResource BoolToVisibility}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="360"
                  Margin="0,40,0,0">
        <TextBlock Text="PDF로 출력 가능한 Plot 장치를 찾지 못했습니다." HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Text="AutoCAD에 'DWG To PDF.pc3' 같은 PDF 장치가 설치되어 있는지 확인해주세요."
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,4,0,0" />
      </StackPanel>

      <!-- Ready -->
      <StackPanel Visibility="{Binding ShowReadyForm, Converter={StaticResource BoolToVisibility}}"
                  MaxWidth="520"
                  HorizontalAlignment="Left">
        <Border Style="{StaticResource PanelBorder}" Padding="16">
          <StackPanel>
            <TextBlock Text="출력 범위" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <RadioButton GroupName="DrawingPdfScope"
                         Content="현재 Layout"
                         IsChecked="{Binding IsCurrentLayoutScope}"
                         AutomationProperties.Name="현재 Layout 출력"
                         Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Layouts}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Name"
                      SelectedValue="{Binding SelectedLayoutName}"
                      IsEnabled="{Binding IsCurrentLayoutScope}"
                      AutomationProperties.Name="출력할 Layout 선택"
                      Width="220"
                      HorizontalAlignment="Left"
                      Margin="20,0,0,10" />

            <RadioButton GroupName="DrawingPdfScope"
                         Content="Model 영역 지정"
                         IsChecked="{Binding IsWindowScope}"
                         AutomationProperties.Name="Model 영역 지정 출력"
                         Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding SelectWindowCommand}"
                      AutomationProperties.Name="AutoCAD에서 영역 지정"
                      Content="{Binding SelectWindowButtonLabel}"
                      Margin="0,0,8,0" />
              <TextBlock Text="{Binding WindowSummaryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </StackPanel>

            <Border BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />

            <TextBlock Text="용지" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton GroupName="DrawingPdfPaper"
                           Content="A4"
                           IsChecked="{Binding IsA4}"
                           IsEnabled="{Binding IsA4Available}"
                           AutomationProperties.Name="A4 용지 선택"
                           Margin="0,0,16,0" />
              <RadioButton GroupName="DrawingPdfPaper"
                           Content="A3"
                           IsChecked="{Binding IsA3}"
                           IsEnabled="{Binding IsA3Available}"
                           AutomationProperties.Name="A3 용지 선택" />
            </StackPanel>

            <TextBlock Text="방향" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton GroupName="DrawingPdfOrientation"
                           Content="자동"
                           IsChecked="{Binding IsAutoOrientation}"
                           AutomationProperties.Name="방향 자동 선택"
                           Margin="0,0,16,0" />
              <RadioButton GroupName="DrawingPdfOrientation"
                           Content="세로"
                           IsChecked="{Binding IsPortraitOrientation}"
                           AutomationProperties.Name="세로 방향 선택"
                           Margin="0,0,16,0" />
              <RadioButton GroupName="DrawingPdfOrientation"
                           Content="가로"
                           IsChecked="{Binding IsLandscapeOrientation}"
                           AutomationProperties.Name="가로 방향 선택" />
            </StackPanel>

            <TextBlock Text="색상" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <RadioButton GroupName="DrawingPdfColor"
                           Content="컬러(기존 설정 유지)"
                           IsChecked="{Binding IsKeepExistingColor}"
                           AutomationProperties.Name="컬러 기존 설정 유지 선택"
                           Margin="0,0,16,0" />
              <RadioButton GroupName="DrawingPdfColor"
                           Content="흑백"
                           IsChecked="{Binding IsMonochromeColor}"
                           IsEnabled="{Binding IsMonochromeAvailable}"
                           AutomationProperties.Name="흑백 선택" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource InlineMessageBorder}"
                Margin="0,12,0,0"
                Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource InlineMessageText}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding OpenFileCommand}"
                      AutomationProperties.Name="도면 PDF 파일 열기"
                      Content="파일 열기"
                      Margin="0,0,8,0" />
              <Button Style="{StaticResource QuietButton}"
                      Command="{Binding OpenFolderCommand}"
                      AutomationProperties.Name="도면 PDF 폴더 열기"
                      Content="폴더 열기" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource InlineMessageBorder}"
                Margin="0,12,0,0"
                Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource InlineMessageText}" Foreground="{StaticResource BrushError}" />
        </Border>

        <Button Style="{StaticResource PrimaryButton}"
                Command="{Binding ExportCommand}"
                AutomationProperties.Name="도면 PDF로 저장"
                Content="{Binding ExportButtonLabel}"
                HorizontalAlignment="Left"
                Margin="0,16,0,0" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
