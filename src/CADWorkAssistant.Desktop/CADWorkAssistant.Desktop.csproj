<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- self-contained/win-x64/RID은 csproj 기본값으로 박아두지 않는다 - `dotnet build`/`dotnet run`
         (CLAUDE.md에 문서화된 일상 개발 루프)이 매번 win-x64 런타임 팩을 복원하게 되는 걸 피하기 위해
         scripts/build-release.ps1이 publish 시점에만 win-x64 self contained 옵션을 넘긴다.
         WPF는 binding/reflection에 의존해 Trimming/단일 파일이 런타임에서 조용히 깨질 수 있으므로
         (CLAUDE.md의 "컴파일 성공은 동작 확인이 아니다" 원칙과 같은 이유) 둘 다 켜지 않는다. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CADWorkAssistant.Core\CADWorkAssistant.Core.csproj" />
    <ProjectReference Include="..\CADWorkAssistant.Infrastructure\CADWorkAssistant.Infrastructure.csproj" />
    <ProjectReference Include="..\CADWorkAssistant.Persistence\CADWorkAssistant.Persistence.csproj" />
    <ProjectReference Include="..\CADWorkAssistant.Documents\CADWorkAssistant.Documents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ApplicationIcon(위)은 exe의 Win32 리소스 아이콘만 담당한다 - WPF Window.Icon은 별도로 pack URI로
         런타임에 로드하므로 .ico도 Resource로 함께 포함해야 타이틀바/Alt-Tab 아이콘이 실제로 뜬다. -->
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>
</Project>
