<Window x:Class="CADWorkAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CADWorkAssistant.Desktop.Views"
        xmlns:conv="clr-namespace:CADWorkAssistant.Desktop.Converters"
        Title="CAD Work Assistant"
        Icon="/Assets/AppIcon.ico"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="CAD Work Assistant workspace">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Key="I" Modifiers="Alt" Command="{Binding ToggleInspectorCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.InputBindings>

  <Grid Background="{StaticResource BrushBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" MinWidth="196" />
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="320" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource BrushSurfaceRaised}"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="0,0,1,0">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,2,0,14">
            <TextBlock Text="CAD Work Assistant" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="AutoCAD automation workspace" Style="{StaticResource CaptionText}" />
          </StackPanel>

          <Button Grid.Row="1"
                  Command="{Binding OpenProjectDialogCommand}"
                  AutomationProperties.Name="{Binding CurrentProjectName}"
                  ToolTip="프로젝트 생성/전환"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource BrushTextMuted}" Data="M2,3 H6 L7,5 H12 V11 H2 Z" />
              <TextBlock Grid.Column="1"
                         Text="{Binding CurrentProjectName}"
                         Margin="8,0"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>

          <Button Grid.Row="2"
                  Command="{Binding OpenCommandPaletteCommand}"
                  AutomationProperties.Name="Open command palette"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource BrushTextMuted}" Data="M2,4 L12,4 M2,7 L9,7 M2,10 L12,10" />
              <TextBlock Grid.Column="1" Text="Command" Margin="8,0" />
              <TextBlock Grid.Column="2" Text="Ctrl+K" Style="{StaticResource CaptionText}" />
            </Grid>
          </Button>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Navigation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Group}"
                               Style="{StaticResource CaptionText}"
                               Visibility="{Binding ShowGroupHeader, Converter={StaticResource BoolToVisibility}}"
                               Margin="2,12,0,4" />
                    <Button Style="{StaticResource NavItemButton}"
                            Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsImplemented}"
                            AutomationProperties.Name="{Binding Label}"
                            ToolTip="{Binding TooltipText}"
                            Margin="0,0,0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3"
                                Height="18"
                                Background="{StaticResource BrushAccent}"
                                CornerRadius="2"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Style="{StaticResource CaptionText}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="4">
            <Border Style="{StaticResource PanelBorder}"
                    Padding="10"
                    Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="AutoCAD" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ConnectionStatusGlyph}"
                             Foreground="{Binding ConnectionStatusBrush}"
                             FontWeight="Bold"
                             Width="14"
                             Margin="0,0,6,0"
                             AutomationProperties.Name="{Binding ConnectionLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding ConnectionLabel}" />
                </Grid>
                <TextBlock Text="{Binding ActiveDrawing}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>

            <!-- TRSN CLARUS 브랜드 크레딧 - 항상 보이되 시선을 끌지 않는 muted 한 줄 (사용자 요청). -->
            <TextBlock Text="TRSN CLARUS"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="178" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Visibility="{Binding IsDashboardContentVisible, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="178" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Quantity Workspace" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource ToolButton}"
                    Command="{Binding ToggleInspectorCommand}"
                    AutomationProperties.Name="Toggle property inspector"
                    ToolTip="Toggle property inspector">
              <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource BrushText}" Data="M2,2 H13 V13 H2 Z M5,2 V13 M2,6 H5" />
            </Button>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Quantity Results" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                <TextBlock Text="Length/Area/Vertical Area/Parapet에서 추가한 산출내역이 최신순으로 쌓입니다" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding QuantityRecords}"
                        Visibility="{Binding HasQuantityRecords, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="78" />
                  <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="112" />
                  <DataGridTextColumn Header="LAYER" Binding="{Binding Layer}" Width="116" />
                  <DataGridTextColumn Header="OBJECTS" Binding="{Binding ObjectCount}" Width="88" />
                  <DataGridTextColumn Header="VALUE" Binding="{Binding Value, StringFormat=N3}" Width="110" />
                  <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="64" />
                  <DataGridTextColumn Header="SOURCE DRAWING" Binding="{Binding SourceDrawing}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          MaxWidth="360"
                          Visibility="{Binding HasQuantityRecords, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="아직 추가된 산출내역이 없습니다" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="Length / Area / Vertical Area / Parapet에서 측정 후 &quot;산출내역 추가&quot;를 누르면 여기에 표시됩니다."
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding Activity}"
                       BorderThickness="0"
                       Background="{StaticResource BrushSurface}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding CreatedAt, StringFormat=HH:mm:ss}" Style="{StaticResource CaptionText}" />
                      <TextBlock Grid.Column="1" Text="{Binding ActivityType}" FontWeight="SemiBold" />
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="1"
                         Text="최근 활동이 없습니다. 산출내역을 추가하면 여기에 기록됩니다."
                         Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Border>
        </Grid>

        <views:LengthPanel Grid.Row="0"
                            Grid.RowSpan="4"
                            DataContext="{Binding Length}"
                            Visibility="{Binding DataContext.IsLengthToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:AreaPanel Grid.Row="0"
                          Grid.RowSpan="4"
                          DataContext="{Binding Area}"
                          Visibility="{Binding DataContext.IsAreaToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:VerticalAreaPanel Grid.Row="0"
                                  Grid.RowSpan="4"
                                  DataContext="{Binding VerticalArea}"
                                  Visibility="{Binding DataContext.IsVerticalAreaToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:ParapetPanel Grid.Row="0"
                             Grid.RowSpan="4"
                             DataContext="{Binding Parapet}"
                             Visibility="{Binding DataContext.IsParapetToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:DrawingPanel Grid.Row="0"
                             Grid.RowSpan="4"
                             DataContext="{Binding Drawing}"
                             Visibility="{Binding DataContext.IsDrawingToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:HistoryPanel Grid.Row="0"
                             Grid.RowSpan="4"
                             DataContext="{Binding History}"
                             Visibility="{Binding DataContext.IsHistoryToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:ExcelExportPanel Grid.Row="0"
                                 Grid.RowSpan="4"
                                 DataContext="{Binding ExcelExport}"
                                 Visibility="{Binding DataContext.IsExcelExportToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:PdfExportPanel Grid.Row="0"
                               Grid.RowSpan="4"
                               DataContext="{Binding PdfExport}"
                               Visibility="{Binding DataContext.IsPdfExportToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <views:SettingsPanel Grid.Row="0"
                              Grid.RowSpan="4"
                              DataContext="{Binding Settings}"
                              Visibility="{Binding DataContext.IsSettingsToolSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <Border x:Name="InspectorPanel"
              Grid.Column="2"
              Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}"
              Background="{StaticResource BrushSurfaceRaised}"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="Property Inspector" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding InspectorTitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,12" />

            <Border Style="{StaticResource PanelBorder}" Padding="12">
              <ItemsControl ItemsSource="{Binding InspectorRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource InspectorLabel}" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Value}"
                                 Style="{StaticResource InspectorValue}"
                                 MaxWidth="170"
                                 TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource BrushSurfaceRaised}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ConnectionStatusGlyph}"
                   Foreground="{Binding ConnectionStatusBrush}"
                   FontWeight="Bold"
                   Margin="0,0,5,0"
                   AutomationProperties.Name="{Binding ConnectionLabel}" />
        <TextBlock Grid.Column="1" Text="{Binding ConnectionLabel}" FontWeight="SemiBold" Margin="0,0,18,0" />
        <TextBlock Grid.Column="2" Text="{Binding ActiveDrawing}" />
        <TextBlock Grid.Column="3" Text="{Binding Units, StringFormat=Units: {0}}" Style="{StaticResource CaptionText}" Margin="18,0" />
        <TextBlock Grid.Column="4" Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}" />
      </Grid>
    </Border>

    <Grid Grid.RowSpan="2"
          Background="{StaticResource BrushScrim}"
          Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="CommandPaletteDialog"
              Width="620"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              Margin="0,78,0,0"
              Style="{StaticResource PanelBorder}"
              Padding="12"
              AutomationProperties.Name="Command palette dialog">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Command search"
                     ToolTip="Search commands, drawings, layers, and exports" />
            <Button Grid.Column="1"
                    Command="{Binding CloseCommandPaletteCommand}"
                    Style="{StaticResource ToolButton}"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Close command palette">
              <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource BrushText}" Data="M2,2 L10,10 M10,2 L2,10" />
            </Button>
          </Grid>
          <TextBlock Text="Commands" Style="{StaticResource CaptionText}" Margin="2,12,0,6" />
          <Button Command="{Binding ToggleInspectorCommand}"
                  AutomationProperties.Name="Toggle property inspector"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Toggle property inspector" />
              <TextBlock Grid.Column="1" Text="Alt+I" Style="{StaticResource CaptionText}" />
            </Grid>
          </Button>
          <TextBlock Text="Esc closes the palette. Buttons remain reachable by keyboard tab order." Style="{StaticResource CaptionText}" Margin="2,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
