<Window x:Class="CADWorkAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Work Assistant"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="CAD Work Assistant workspace">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding RunExtractionCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.InputBindings>

  <Grid Background="{StaticResource BrushBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" MinWidth="196" />
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="320" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource BrushSurfaceRaised}"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="0,0,1,0">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,2,0,14">
            <TextBlock Text="CAD Work Assistant" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="AutoCAD automation workspace" Style="{StaticResource CaptionText}" />
          </StackPanel>

          <Button Grid.Row="1"
                  Command="{Binding OpenCommandPaletteCommand}"
                  AutomationProperties.Name="Open command palette"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource BrushTextMuted}" Data="M2,4 L12,4 M2,7 L9,7 M2,10 L12,10" />
              <TextBlock Grid.Column="1" Text="Command" Margin="8,0" />
              <TextBlock Grid.Column="2" Text="Ctrl+K" Style="{StaticResource CaptionText}" />
            </Grid>
          </Button>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Navigation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Group}"
                               Style="{StaticResource CaptionText}"
                               Visibility="{Binding ShowGroupHeader, Converter={StaticResource BoolToVisibility}}"
                               Margin="2,12,0,4" />
                    <Button Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label}"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="34"
                            Margin="0,0,0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3"
                                Height="18"
                                Background="{StaticResource BrushAccent}"
                                CornerRadius="2"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Style="{StaticResource CaptionText}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="3"
                  Style="{StaticResource PanelBorder}"
                  Padding="10"
                  Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="AutoCAD" Style="{StaticResource SectionTitle}" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding ConnectionLabel}" />
              </Grid>
              <TextBlock Text="{Binding ActiveDrawing}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="178" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Quantity Workspace" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource ToolButton}"
                    Command="{Binding ToggleInspectorCommand}"
                    AutomationProperties.Name="Toggle property inspector"
                    ToolTip="Toggle property inspector"
                    Margin="0,0,6,0">
              <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource BrushText}" Data="M2,2 H13 V13 H2 Z M5,2 V13 M2,6 H5" />
            </Button>
            <Button Command="{Binding CopyResultCommand}" Margin="0,0,6,0">Copy</Button>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunExtractionCommand}">Extract Length</Button>
          </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" />
                  <TextBlock Text="{Binding Value}" Style="{StaticResource NumericText}" FontSize="18" Margin="0,5,0,2" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quantity Results" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                <TextBlock Text="Dense table optimized for repeated measurement work" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Filter results"
                       ToolTip="Filter results"
                       Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding QuantityRecords}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="78" />
                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="112" />
                <DataGridTextColumn Header="LAYER" Binding="{Binding Layer}" Width="116" />
                <DataGridTextColumn Header="OBJECTS" Binding="{Binding ObjectCount}" Width="88" />
                <DataGridTextColumn Header="VALUE" Binding="{Binding Value, StringFormat=N3}" Width="110" />
                <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="64" />
                <DataGridTextColumn Header="SOURCE DRAWING" Binding="{Binding SourceDrawing}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Activity}"
                     BorderThickness="0"
                     Background="{StaticResource BrushSurface}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="66" />
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Message}" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="InspectorPanel"
              Grid.Column="2"
              Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}"
              Background="{StaticResource BrushSurfaceRaised}"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="Property Inspector" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Selection, layer, and export settings" Style="{StaticResource CaptionText}" Margin="0,2,0,12" />

            <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Current Selection" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Objects" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="1" Text="4" Style="{StaticResource NumericText}" />
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Layer" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="1" Text="A-WALL" />
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Total Length" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="1" Text="255.941 m" Style="{StaticResource NumericText}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Calculation" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="Mode" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                <ComboBox SelectedIndex="0" MinHeight="32" AutomationProperties.Name="Calculation mode">
                  <ComboBoxItem Content="Polyline length" />
                  <ComboBoxItem Content="Closed area" />
                  <ComboBoxItem Content="Vertical area" />
                  <ComboBoxItem Content="Parapet quantity" />
                </ComboBox>
                <TextBlock Text="Rounding" Style="{StaticResource CaptionText}" Margin="0,10,0,4" />
                <ComboBox SelectedIndex="1" MinHeight="32" AutomationProperties.Name="Rounding precision">
                  <ComboBoxItem Content="0.001" />
                  <ComboBoxItem Content="0.01" />
                  <ComboBoxItem Content="0.1" />
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Padding="12">
              <StackPanel>
                <TextBlock Text="Open Drawings" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Drawings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                        <StackPanel>
                          <TextBlock Text="{Binding FileName}" />
                          <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource BrushSurfaceRaised}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="AutoCAD:" Style="{StaticResource CaptionText}" Margin="0,0,4,0" />
        <TextBlock Grid.Column="1" Text="{Binding ConnectionLabel}" FontWeight="SemiBold" Margin="0,0,18,0" />
        <TextBlock Grid.Column="2" Text="{Binding ActiveDrawing}" />
        <TextBlock Grid.Column="3" Text="{Binding Units, StringFormat=Units: {0}}" Style="{StaticResource CaptionText}" Margin="18,0" />
        <TextBlock Grid.Column="4" Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}" />
      </Grid>
    </Border>

    <Grid Grid.RowSpan="2"
          Background="#66000000"
          Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="CommandPaletteDialog"
              Width="620"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              Margin="0,78,0,0"
              Style="{StaticResource PanelBorder}"
              Padding="12"
              AutomationProperties.Name="Command palette dialog">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Command search"
                     ToolTip="Search commands, drawings, layers, and exports" />
            <Button Grid.Column="1"
                    Command="{Binding CloseCommandPaletteCommand}"
                    Style="{StaticResource ToolButton}"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Close command palette">
              <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource BrushText}" Data="M2,2 L10,10 M10,2 L2,10" />
            </Button>
          </Grid>
          <TextBlock Text="Commands" Style="{StaticResource CaptionText}" Margin="2,12,0,6" />
          <Button Command="{Binding RunExtractionCommand}" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Extract length from current AutoCAD selection" />
              <TextBlock Grid.Column="1" Text="Ctrl+P" Style="{StaticResource CaptionText}" />
            </Grid>
          </Button>
          <Button Command="{Binding ToggleInspectorCommand}" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Toggle property inspector" />
              <TextBlock Grid.Column="1" Text="Alt+I" Style="{StaticResource CaptionText}" />
            </Grid>
          </Button>
          <TextBlock Text="Esc closes the palette. Buttons remain reachable by keyboard tab order." Style="{StaticResource CaptionText}" Margin="2,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
