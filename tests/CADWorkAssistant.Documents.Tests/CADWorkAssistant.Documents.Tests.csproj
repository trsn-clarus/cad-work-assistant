<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!--
      PdfPig - PDF 텍스트 추출/reopen 검증 전용(Milestone 10 §84-86). 테스트 프로젝트에만 두고
      배포되는 CADWorkAssistant.Documents/Desktop에는 절대 넣지 않는다 - 제품 런타임 의존성을
      늘리지 않으면서 "실제로 열어서 내용을 확인"하는 검증을 할 수 있다. Apache-2.0 라이선스.
    -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CADWorkAssistant.Core\CADWorkAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\CADWorkAssistant.Documents\CADWorkAssistant.Documents.csproj" />
  </ItemGroup>

</Project>
